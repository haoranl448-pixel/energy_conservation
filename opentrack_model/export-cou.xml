<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE opentrack SYSTEM "opentrack.dtd">
<opentrack>
	<distributions>
		<distribution name="Duration Distribution 1" type="piecewise linear">
			<step from="0.0" to="180.0" percentage="0.0"/>
			<step from="180.0" to="240.0" percentage="100.0"/>
		</distribution>
		<distribution name="Experiment 1" type="piecewise linear">
			<step from="0.0" to="10.0" percentage="10.0"/>
			<step from="10.0" to="20.0" percentage="80.0"/>
			<step from="20.0" to="60.0" percentage="10.0"/>
		</distribution>
		<distribution name="Uniform 30-50" type="piecewise linear">
			<step from="0.0" to="30.0" percentage="0.0"/>
			<step from="30.0" to="50.0" percentage="100.0"/>
		</distribution>
	</distributions>
</opentrack>
