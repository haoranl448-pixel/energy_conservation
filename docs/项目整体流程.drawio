  <diagram id="energy-project-flow-v2" name="项目整体流程">
    <mxGraphModel dx="1500" dy="2100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;列车节能运行规划项目整体流程&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1200" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="历史数据 → 可追溯数据集 → 候选曲线与能耗 → 三类规划 → 独立物理验证 → 成果输出&lt;br&gt;&lt;b&gt;主程序入口：scripts_new/main.py&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="200" y="64" width="1200" height="42" as="geometry"/></mxCell>

        <mxCell id="band1" value="1  基础输入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=16;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingTop=9;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1480" height="185" as="geometry"/></mxCell>
        <mxCell id="inputs" value="&lt;b&gt;历史运行数据&lt;/b&gt;：动态轨迹、静态记录、速度、电流、电压、时间&lt;br&gt;&lt;b&gt;线路基础数据&lt;/b&gt;：站点、里程、坡度、曲率、线路限速&lt;br&gt;&lt;b&gt;车辆与载重数据&lt;/b&gt;：车辆参数、编组质量、各区间载重变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#D6B656;strokeWidth=1.5;fontSize=14;arcSize=6;align=left;spacingLeft=24;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="175" width="1060" height="100" as="geometry"/></mxCell>

        <mxCell id="band2" value="2  数据处理与质量控制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=16;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingTop=9;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="1480" height="270" as="geometry"/></mxCell>
        <mxCell id="process" value="&lt;b&gt;原始数据清洗与区间分段&lt;/b&gt;&lt;br&gt;01_data_process.py&lt;br&gt;计算速度、加速度、累计里程及历史实测能耗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="600" height="90" as="geometry"/></mxCell>
        <mxCell id="dataset" value="&lt;b&gt;统一可追溯区间数据集&lt;/b&gt;&lt;br&gt;逐点轨迹 + 全局趟次 run_id/本地 segment + 前后站连续关系&lt;br&gt;曲线质量标签 + 区间质量/载重 + 运行等级" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E2F0D9;strokeColor=#82B366;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="760" height="80" as="geometry"/></mxCell>

        <mxCell id="band3" value="3  模型与候选工况构建" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=16;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingTop=9;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="635" width="1480" height="345" as="geometry"/></mxCell>
        <mxCell id="physicsbranch" value="&lt;b&gt;物理模型与残差修正&lt;/b&gt;&lt;br&gt;train_simu.py&lt;br&gt;02_train_residual_new.py&lt;br&gt;&lt;br&gt;物理机械能 + 实测偏差学习" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="150" y="705" width="370" height="125" as="geometry"/></mxCell>
        <mxCell id="atobranch" value="&lt;b&gt;ATO 模板与候选曲线&lt;/b&gt;&lt;br&gt;04_train_ATO_v8.py&lt;br&gt;05_simulate_ATO_v8.py&lt;br&gt;&lt;br&gt;质量标签0真实曲线 + 受控插值/相邻外推" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="615" y="705" width="370" height="125" as="geometry"/></mxCell>
        <mxCell id="historybranch" value="&lt;b&gt;历史工况提取&lt;/b&gt;&lt;br&gt;07_full_line_validation_results.py&lt;br&gt;&lt;br&gt;按追溯关系提取真实运行时间、停站时间、速度与能耗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="705" width="370" height="125" as="geometry"/></mxCell>
        <mxCell id="modelout" value="&lt;b&gt;分区间残差模型&lt;/b&gt;&lt;br&gt;权重 + scaler + 特征定义" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F0E6F4;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="175" y="875" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="curveout" value="&lt;b&gt;v4候选速度曲线库&lt;/b&gt;&lt;br&gt;每区间、每等级、逐点曲线及来源标签" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="875" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="historyout" value="&lt;b&gt;历史运行基准&lt;/b&gt;&lt;br&gt;运行/停站时间、实测能耗、历史速度" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E8F1FB;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1105" y="875" width="320" height="70" as="geometry"/></mxCell>

        <mxCell id="band4" value="4  规划输入构建" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=16;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingTop=9;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1480" height="205" as="geometry"/></mxCell>
        <mxCell id="menu" value="&lt;b&gt;趟次级候选能耗菜单&lt;/b&gt;&lt;br&gt;06_ato_generated_results_energy.py&lt;br&gt;候选速度 × 区间质量 × 物理模型 × 残差修正&lt;br&gt;输出：区间 × 等级 × 运行时间 × 预测能耗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="220" y="1060" width="530" height="110" as="geometry"/></mxCell>
        <mxCell id="baseline" value="&lt;b&gt;规划约束与比较基准&lt;/b&gt;&lt;br&gt;历史运行时间与停站时间&lt;br&gt;历史实测能耗、质量和速度曲线&lt;br&gt;保证规划与同一全局趟次对应" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="850" y="1060" width="530" height="110" as="geometry"/></mxCell>

        <mxCell id="band5" value="5  三类动态规划方案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#E6B86A;fontSize=16;fontStyle=1;fontColor=#7C4A03;align=left;verticalAlign=top;spacingTop=9;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="1245" width="1480" height="315" as="geometry"/></mxCell>
        <mxCell id="dp" value="&lt;b&gt;全线动态规划&lt;/b&gt;　08_ato_class_globall_v2.py&lt;br&gt;在目标总时间、停站边界、等级可用性和曲线来源约束下选择低能耗组合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="365" y="1290" width="870" height="75" as="geometry"/></mxCell>
        <mxCell id="standard" value="&lt;b&gt;标准 DP&lt;/b&gt;&lt;br&gt;真实曲线来源优先&lt;br&gt;历史停站精确匹配；失败后才进入 ±2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="1405" width="350" height="85" as="geometry"/></mxCell>
        <mxCell id="energyfirst" value="&lt;b&gt;Energy First&lt;/b&gt;&lt;br&gt;放宽等级与曲线来源限制&lt;br&gt;历史停站精确匹配；失败后才进入 ±2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="625" y="1405" width="350" height="85" as="geometry"/></mxCell>
        <mxCell id="dwell5" value="&lt;b&gt;停站放宽 5% DP&lt;/b&gt;&lt;br&gt;真实曲线来源优先&lt;br&gt;允许历史停站时间在 ±5% 内调整" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1405" width="350" height="85" as="geometry"/></mxCell>
        <mxCell id="planout" value="&lt;b&gt;统一规划结果&lt;/b&gt;：逐区间等级、运行时间、停站时间、规划能耗及对应速度曲线" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="1510" width="700" height="38" as="geometry"/></mxCell>

        <mxCell id="band6" value="6  独立仿真验证" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#5AB7A7;fontSize=16;fontStyle=1;fontColor=#115E59;align=left;verticalAlign=top;spacingTop=9;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="1590" width="1480" height="245" as="geometry"/></mxCell>
        <mxCell id="simuverify" value="&lt;b&gt;Simulink 机理模型独立复算&lt;/b&gt;&lt;br&gt;plot_simu_code_trip_compare.py&lt;br&gt;输入冻结后的历史/规划速度曲线和各区间质量&lt;br&gt;输出历史复现误差与三类规划机械能耗节能结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=14;arcSize=6;" vertex="1" parent="1"><mxGeometry x="190" y="1650" width="740" height="120" as="geometry"/></mxCell>
        <mxCell id="otoptional" value="&lt;b&gt;可选：OpenTrack 工程仿真&lt;/b&gt;&lt;br&gt;timetable XML + OTD route map/区间限速&lt;br&gt;输出 `.tsvP` 速度与机械能耗&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;不作为当前 Simulink 结论的必要前提&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;strokeWidth=1.5;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1040" y="1650" width="370" height="120" as="geometry"/></mxCell>

        <mxCell id="band7" value="7  统一成果输出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=16;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingTop=9;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="60" y="1865" width="1480" height="260" as="geometry"/></mxCell>
